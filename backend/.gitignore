# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/
pip-env/
build/venv/

# Packaging / distribution
dist/
build/
*.egg-info/
pip-wheel-metadata/

# Local secrets / environment
.env
.env.*
secrets.json

# Local uploaded media
media/

# Migrations: keep source files tracked, ignore compiled bits
**/migrations/__pycache__/
**/migrations/*.pyc

# IDE / editor
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
